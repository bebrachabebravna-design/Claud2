# ============ Нейродокс — кэширование, сжатие, безопасность ============

# --- GZIP-сжатие (быстрая загрузка, лучше для SEO) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Кэширование в браузере ---
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML — короткий кэш, чтобы обновления статей были видны быстро
  ExpiresByType text/html "access plus 1 hours"
  # Картинки, шрифты, стили — надолго
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js|woff2|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # безопасность
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# --- Защита служебных файлов блога ---
<FilesMatch "^(config|lib)\.php$">
  Order allow,deny
  Deny from all
</FilesMatch>

# --- 404 на несуществующие страницы ---
ErrorDocument 404 /404.html
